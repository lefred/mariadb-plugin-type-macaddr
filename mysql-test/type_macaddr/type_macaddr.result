CREATE TABLE m (m6 MACADDR NOT NULL, m8 MACADDR8 NOT NULL,
KEY(m6), KEY(m8));
INSERT INTO m VALUES
('08:00:2b:01:02:03', '08:00:2b:01:02:03:04:05'),
('08-00-2B-01-02-04', '08-00-2B-01-02-04'),
('0800.2b01.0205', '08002b010205');
SELECT m6, m8 FROM m ORDER BY m6;
m6	m8
08:00:2b:01:02:03	08:00:2b:01:02:03:04:05
08:00:2b:01:02:04	08:00:2b:ff:fe:01:02:04
08:00:2b:01:02:05	08:00:2b:ff:fe:01:02:05
SELECT CAST('08002b:010203' AS MACADDR),
CAST('08002b-0102030405' AS MACADDR8);
CAST('08002b:010203' AS MACADDR)	CAST('08002b-0102030405' AS MACADDR8)
08:00:2b:01:02:03	08:00:2b:01:02:03:04:05
SELECT MACADDR_TRUNC('12:34:56:78:90:ab'),
MACADDR8_TRUNC('12:34:56:78:90:ab:cd:ef'),
MACADDR8_SET7BIT('00:34:56:ab:cd:ef');
MACADDR_TRUNC('12:34:56:78:90:ab')	MACADDR8_TRUNC('12:34:56:78:90:ab:cd:ef')	MACADDR8_SET7BIT('00:34:56:ab:cd:ef')
12:34:56:00:00:00	12:34:56:00:00:00:00:00	02:34:56:ff:fe:ab:cd:ef
SELECT CAST('bad address' AS MACADDR) IS NULL,
CAST('08:00:2b:01:02:03:04:05' AS MACADDR) IS NULL,
CAST('08::00:2b:01:02:03' AS MACADDR) IS NULL;
CAST('bad address' AS MACADDR) IS NULL	CAST('08:00:2b:01:02:03:04:05' AS MACADDR) IS NULL	CAST('08::00:2b:01:02:03' AS MACADDR) IS NULL
1	1	1
Warnings:
Warning	1292	Incorrect macaddr value: 'bad address'
Warning	1292	Incorrect macaddr value: '08:00:2b:01:02:03:04:05'
Warning	1292	Incorrect macaddr value: '08::00:2b:01:02:03'
#
# Only the group widths PostgreSQL documents are accepted:
# a separator may split byte-pairs, an OUI (3 bytes) from the
# remainder, or 4-hex-digit groups -- not any other digit boundary.
#
SELECT CAST('aa:bb:ccddee:ff' AS MACADDR) IS NULL,
CAST('08:002b:01:0203' AS MACADDR) IS NULL;
CAST('aa:bb:ccddee:ff' AS MACADDR) IS NULL	CAST('08:002b:01:0203' AS MACADDR) IS NULL
1	1
Warnings:
Warning	1292	Incorrect macaddr value: 'aa:bb:ccddee:ff'
Warning	1292	Incorrect macaddr value: '08:002b:01:0203'
#
# MACADDR_TRUNC()/MACADDR8_TRUNC()/MACADDR8_SET7BIT() accept a raw
# binary argument of the correct byte length the same way
# CAST(x'...' AS MACADDR[8]) does, instead of hex-parsing the bytes
# as text.
#
SELECT MACADDR_TRUNC(x'08002b010203'),
MACADDR8_TRUNC(x'08002bfffe010203'),
MACADDR8_SET7BIT(x'003456778899aabb');
MACADDR_TRUNC(x'08002b010203')	MACADDR8_TRUNC(x'08002bfffe010203')	MACADDR8_SET7BIT(x'003456778899aabb')
08:00:2b:00:00:00	08:00:2b:00:00:00:00:00	02:34:56:77:88:99:aa:bb
DROP TABLE m;
